# =============================================================================
# Dataproc Multi-Tenant Cluster Configuration Template (.env.example)
#
# Copy this file to scripts/.env.local to customize for your GCP environment:
#   cp scripts/.env.example scripts/.env.local
# Note: scripts/.env and scripts/.env.local are gitignored and will not be committed.
# =============================================================================

# -----------------------------------------------------------------------------
# Core Google Cloud Settings
# -----------------------------------------------------------------------------
# Target GCP Project ID (if unset, auto-detected from 'gcloud config get-value project')
PROJECT_ID="my-dataproc-project"

# Dataproc Region and Compute Engine Zone
REGION="us-central1"
ZONE="us-central1-a"

# Cluster Name prefix (defaults to pyspark-cluster-multitenant-<timestamp> if unset)
CLUSTER_NAME="pyspark-cluster-demo"

# Dataproc Image Version (2.2-debian12 or 2.3-debian12)
IMAGE_VERSION="2.3-debian12"

# -----------------------------------------------------------------------------
# Compute & Hardware Topology
# -----------------------------------------------------------------------------
MASTER_MACHINE_TYPE="n1-standard-4"
MASTER_BOOT_DISK_SIZE="1000GB"
NUM_WORKERS=2
WORKER_MACHINE_TYPE="n1-standard-8"
WORKER_BOOT_DISK_SIZE="1000GB"
NETWORK_TAGS="dataproc-internal"

# -----------------------------------------------------------------------------
# Secure Multi-Tenancy User Mapping
# -----------------------------------------------------------------------------
# Format: "<HUMAN_OR_CLIENT_EMAIL>:<EXECUTION_SERVICE_ACCOUNT>"
# Separate multiple users with commas.
# Note: Dataproc derives Linux usernames from the email prefix before '@'.
#       Each mapping entry MUST yield a distinct username prefix.
#
# If left empty, scripts/create_multitenant_cluster.sh will automatically map
# your active gcloud account to the default Compute Engine service account:
#   <project-number>-compute@developer.gserviceaccount.com
#
# Example with explicit service accounts:
# USER_MAPPING="alice@example.com:ds-team@my-dataproc-project.iam.gserviceaccount.com,bob@example.com:ds-team@my-dataproc-project.iam.gserviceaccount.com"
USER_MAPPING=""

# -----------------------------------------------------------------------------
# Spark & YARN Resource Allocation Tuning
# -----------------------------------------------------------------------------
# Fraction of queue memory available to ApplicationMasters (0.8 = 80%).
# Critical: prevents kernel launch HTTP 500 / TimeoutError when memory is free.
MAX_AM_RESOURCE_PERCENT=0.8

# Spark Driver & Executor sizing
SPARK_DRIVER_MEMORY="2g"
SPARK_DRIVER_MAX_RESULT_SIZE="1920m"
SPARK_EXECUTOR_MEMORY="2g"
SPARK_EXECUTOR_CORES=2
SPARK_EXECUTOR_INSTANCES=2
SPARK_YARN_AM_MEMORY="640m"

# -----------------------------------------------------------------------------
# YARN Application Lifetime Reaper (Safety Net)
# -----------------------------------------------------------------------------
# Automatically terminate YARN applications exceeding this duration (in seconds).
# 86400 seconds = 24 hours. Prevents zombie sessions from locking AM slots.
YARN_MAX_APP_LIFETIME=86400

# -----------------------------------------------------------------------------
# Optional: Apache Iceberg & BigQuery Metastore Catalog Integration
# -----------------------------------------------------------------------------
# Set to "true" to configure Iceberg extensions and catalog properties
ENABLE_ICEBERG="false"
ICEBERG_WAREHOUSE="gs://${PROJECT_ID}-iceberg"
# Optional: Custom GCS path or URL to pre-built catalog JAR if using beta features:
# ICEBERG_CATALOG_JAR="gs://${PROJECT_ID}-tmp/iceberg-bigquery-catalog-1.6.1-1.0.1-beta.jar"
